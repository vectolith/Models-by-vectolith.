{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ASH PRIME evidence-bound criterion grade",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "inference_run_id",
    "candidate_id",
    "candidate_revision",
    "source_artifact_sha256",
    "case_id",
    "response_sha256",
    "rubric_sha256",
    "rubric_version",
    "grader",
    "criteria",
    "score",
    "graded_at"
  ],
  "properties": {
    "schema_version": {
      "const": "vectolith-ash-prime-grade/1.0"
    },
    "inference_run_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "response_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rubric_version": {
      "type": "string",
      "minLength": 1
    },
    "grader": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "grader_id",
        "grader_version",
        "prompt_version"
      ],
      "properties": {
        "method": {
          "enum": [
            "deterministic",
            "model_assisted",
            "human",
            "hybrid"
          ]
        },
        "grader_id": {
          "type": "string",
          "minLength": 1
        },
        "grader_version": {
          "type": "string",
          "minLength": 1
        },
        "prompt_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion_id",
          "status",
          "evidence_excerpt",
          "rationale",
          "method",
          "confidence"
        ],
        "properties": {
          "criterion_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "unscored"
            ]
          },
          "evidence_excerpt": {
            "type": "string"
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "enum": [
              "deterministic",
              "semantic",
              "human"
            ]
          },
          "confidence": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "failed",
        "unscored",
        "total"
      ],
      "properties": {
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "unscored": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "graded_at": {
      "type": "string",
      "minLength": 1
    },
    "rubric_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
