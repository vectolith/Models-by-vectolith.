{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vectolith.dev/schemas/restricted-evidence-manifest-1.0.json",
  "title": "Vectolith Restricted Evidence Manifest",
  "description": "Metadata-only schema for a manifest stored in a restricted evidence vault. Never place a populated manifest, private storage references, holdout contents, scoring keys, credentials or access records in the public repository.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "created_at",
    "custodian_id",
    "access_policy",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "vectolith-restricted-evidence-manifest/1.0"
    },
    "manifest_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "custodian_id": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque identifier; do not use a person's name or email."
    },
    "access_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "authorized_roles",
        "encryption_at_rest",
        "key_custody_separate"
      ],
      "properties": {
        "classification": {
          "const": "restricted"
        },
        "authorized_roles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "authorized_principal_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "encryption_at_rest": {
          "type": "boolean"
        },
        "key_custody_separate": {
          "type": "boolean"
        },
        "access_control_reference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "category",
          "storage_reference",
          "media_type",
          "byte_length",
          "sha256",
          "version",
          "custodian_id",
          "created_at",
          "access_policy"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "private_holdout_dataset",
              "scoring_key",
              "raw_candidate_output",
              "grade_record_ledger",
              "grading_report",
              "rubric",
              "teacher_inference_artifact",
              "model_license",
              "training_output_permission",
              "holdout_deployment_manifest",
              "holdout_result",
              "provenance_report",
              "leakage_audit",
              "access_log",
              "authorization_record",
              "runtime_image",
              "resource_measurement",
              "other"
            ]
          },
          "storage_reference": {
            "type": "string",
            "minLength": 1,
            "description": "Restricted-vault URI or opaque locator; keep this field only in the restricted manifest."
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          },
          "byte_length": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "source_reference": {
            "type": "string"
          },
          "custodian_id": {
            "type": "string",
            "minLength": 1
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "verified_at": {
            "type": "string",
            "format": "date-time"
          },
          "verified_by": {
            "type": "string"
          },
          "access_policy": {
            "const": "restricted"
          },
          "related_run_id": {
            "type": "string"
          },
          "candidate_id": {
            "type": "string"
          },
          "candidate_revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "rubric_version": {
            "type": "string"
          },
          "authorization_artifact_id": {
            "type": "string"
          },
          "chain_of_custody_artifact_id": {
            "type": "string"
          },
          "notes": {
            "type": "string",
            "description": "Metadata only. Never put protected content, secrets, personal data or scoring material here."
          }
        }
      }
    },
    "integrity_audits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "checked_at",
          "verifier_id",
          "result"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "checked_at": {
            "type": "string",
            "format": "date-time"
          },
          "verifier_id": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "verified",
              "mismatch",
              "unavailable",
              "pending"
            ]
          },
          "report_artifact_id": {
            "type": "string"
          }
        }
      }
    },
    "access_audit_artifact_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "authorization_artifact_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
