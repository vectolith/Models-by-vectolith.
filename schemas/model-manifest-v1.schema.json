{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vectolith.dev/schemas/model-manifest-v1.schema.json",
  "title": "Vectolith model manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "model_id",
    "version",
    "specialization",
    "capabilities",
    "modalities",
    "lifecycle_state",
    "identity_contract_version",
    "safety_baseline"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "model_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{1,127}$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "specialization": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9._:/-]+$"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "modalities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "output"
      ],
      "properties": {
        "input": {
          "type": "array",
          "items": {
            "enum": [
              "text",
              "image",
              "audio",
              "video",
              "structured"
            ]
          },
          "uniqueItems": true
        },
        "output": {
          "type": "array",
          "items": {
            "enum": [
              "text",
              "image",
              "audio",
              "video",
              "structured"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "lifecycle_state": {
      "enum": [
        "experimental",
        "development",
        "evaluation",
        "released",
        "deprecated",
        "retired"
      ]
    },
    "identity_contract_version": {
      "type": "string",
      "minLength": 1
    },
    "safety_baseline": {
      "type": "string",
      "minLength": 1
    },
    "interface_versions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "qualification_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "References to version-bound qualification artifacts; references alone do not confer qualification."
    },
    "resource_constraints": {
      "type": "object"
    },
    "foundation_reference": {
      "type": "string"
    },
    "serving_adapter": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    }
  }
}
